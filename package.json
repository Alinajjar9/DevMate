{
  "name": "devmate",
  "displayName": "DevMate",
  "description": "A VS Code assistant prototype for compact AI-supported project guidance.",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.96.2",
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:devMate.openChat",
    "onView:devmate.dedicatedAssistantView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devMate.openChat",
        "title": "DevMate: Open Chat",
        "category": "DevMate"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "devmate-dedicated-chat",
          "title": "DevMate",
          "icon": "media/devmate.svg"
        }
      ]
    },
    "views": {
      "devmate-dedicated-chat": [
        {
          "type": "webview",
          "id": "devmate.dedicatedAssistantView",
          "name": "Chat",
          "contextualTitle": "DevMate",
          "icon": "media/devmate.svg"
        }
      ]
    },
    "configuration": {
      "title": "DevMate",
      "properties": {
        "devMate.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the local DevMate backend service."
        },
        "devMate.maxTokens": {
          "type": "number",
          "default": 16384,
          "minimum": 128,
          "maximum": 32000,
          "description": "Maximum response tokens shared by model reasoning, answers, and complete Code-mode file contents."
        },
        "devMate.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for later LLM requests."
        },
        "devMate.requestTimeoutSeconds": {
          "type": "integer",
          "default": 330,
          "minimum": 30,
          "maximum": 1830,
          "description": "How long the extension waits for the DevMate backend to return an LLM answer. Keep this above the backend provider timeout."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --listEmittedFiles",
    "check": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test tests/agentTools.test.js tests/apiClient.test.js tests/context.test.js tests/fileChanges.test.js tests/llmProfiles.test.js tests/permissions.test.js tests/projectContext.test.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "@types/vscode": "^1.96.2",
    "typescript": "^5.4.5"
  }
}
